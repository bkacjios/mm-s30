# Makefile.s30 - Majora's Mask for the PocketGo S30 (Allwinner A33, ARMv7
# hard-float, Alpine musl, GLES2 on KMS/EGL, ALSA, evdev). Same layout as
# ports/oot's Makefile.s30.
#
#   make -f Makefile.s30 extract    # ROM -> extracted/, build/ sources (host; the US ROM
#                                   # in baseroms/n64-us/baserom.z64, venv in .venv)
#   make -f Makefile.s30 assets     # asset segments for ARM -> data/*.bin (host)
#   make -f Makefile.s30 -k objs    # compile the game code (bring-up)
#
# WORK is the pocketgo-s30 build tree (sysroot + armv7-clang wrapper).

WORK ?= ../../s30-build
# The shared N64 platform library (display, renderer, audio, input)
N64LIB ?= ../../n64
SYSROOT := $(abspath $(WORK)/sysroot)
VERSION ?= n64-us

# Compile with GCC (the game needs -fno-toplevel-reorder, which clang lacks)
# against the device's musl headers; link with the project's clang/lld wrapper
CC := arm-none-eabi-gcc
OBJCOPY := arm-none-eabi-objcopy
# ovl_En_Slime/z_en_slime.o -> En_Slime
OVL_NAME = $(patsubst ovl_%,%,$(notdir $(patsubst %/,%,$(dir $@))))
LINK := $(WORK)/bin/armv7-clang

TARGET_FLAGS := -marm -march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 \
    -mfloat-abi=hard -fno-short-enums -isystem $(SYSROOT)/usr/include

CFLAGS := $(TARGET_FLAGS) -O2 -Wall -std=gnu23 -DLINUX -D_LANGUAGE_C -D_GNU_SOURCE \
    -DNON_MATCHING -DAVOID_UB -DMM_VERSION=N64_US \
    -DF3DEX_GBI_2 -DF3DEX_GBI_PL -DGBI_DOWHILE \
    -Wno-incompatible-pointer-types -Wno-int-conversion \
    -g -fno-toplevel-reorder -fwrapv -fno-strict-aliasing -funsigned-char -MMD -MP \
    -include include/s30/s30_libc_compat.h \
    -Iinclude -Iinclude/s30 -I$(N64LIB)/include/s30 -Isrc -I. -Iextracted/$(VERSION) -Ibuild/$(VERSION)

BUILD_DIR := build_s30
# libultra's OS from the library too (n64/src/os.c)
N64LIB_OS := 1
include $(N64LIB)/n64.mk

# The game's C files for this version: the spec's src/ objects that have a
# .c (the rest are MIPS assembly or the N64 ROM header/IPL)
SPEC_O := $(shell cpp -P -DMM_VERSION=$(shell echo $(VERSION) | tr a-z- A-Z_) -I. spec/spec | \
    sed -n -E 's/^[ \t]*include[ \t]*"\$$\(BUILD_DIR\)\/(src\/[a-zA-Z0-9\/_.-]+)\.o"/\1/p')
# Replaced on Linux by src/linux/reimpl.c (boot, VI, cartridge, ROM DMA, debug print)
# (src/boot/boot_main.c is the N64 entry point; src/s30/main.c calls Main)
REPLACED := src/boot/boot_main.c src/boot/build.c src/boot/carthandle.c src/boot/idle.c \
    src/boot/viconfig.c src/boot/z_std_dma.c src/boot/syncprintf.c
# The C library functions MM implements itself: musl's are used instead (the
# game's would replace them for the whole process, Mesa and ALSA included)
REPLACED += src/libultra/libc/string.c src/boot/libc/memmove.c src/boot/libc/memset.c \
    src/boot/libc/strcmp.c src/boot/libc/strcpy.c src/boot/libc64/sprintf.c
# libultra's OS is the shared library's (n64/src/os.c): its os/ and io/
# files aren't built (the VI mode tables, in vimodes/, are)
REPLACED += src/libultra/os/% src/libultra/io/%
# The Voice Recognition Unit's driver (os.c: none plugged in), and the flash
# driver: saves go to a file (src/code/sys_flashrom.c)
REPLACED += src/libultra/voice/% src/code/osFlash.c
SRCS := $(filter-out src/makerom/% $(REPLACED),$(wildcard $(addsuffix .c,$(SPEC_O))))
OBJS := $(patsubst src/%.c,$(BUILD_DIR)/src/%.o,$(SRCS))
# The map overhaul (src/s30_map/s30_map.h), game code like the rest
MAP_SRCS := $(filter-out %.inc.c,$(wildcard src/s30_map/*.c src/s30_map/lib/*.c src/s30_map/patches/*.c))
OBJS += $(patsubst src/%.c,$(BUILD_DIR)/src/%.o,$(MAP_SRCS))
$(patsubst src/%.c,$(BUILD_DIR)/src/%.o,$(MAP_SRCS)): CFLAGS += -Isrc/s30_map -Isrc/s30_map/generated

# The port's own code: OS services on Linux (reimpl.c) and the platform layer
PORT_OBJS := $(BUILD_DIR)/src/linux/reimpl.o $(BUILD_DIR)/src/linux/mgu.o \
    $(patsubst src/%.c,$(BUILD_DIR)/src/%.o,$(wildcard src/s30/*.c)) $(N64LIB_OBJS)

TARGET := majora
LIBS := $(N64LIB_LIBS)
# Asset symbol addresses (segment-relative), one definition each
ASSET_SYMBOLS := -Wl,build_assets/assets/symbols.ld

# Per-file defines (as in the decomp's Makefile)
$(BUILD_DIR)/src/boot/build.o: CFLAGS += -DBUILD_CREATOR='"zelda@srd44"' \
    -DBUILD_DATE='"00-07-31"' -DBUILD_TIME='"17:04:16"'
$(BUILD_DIR)/src/audio/lib/seqplayer.o: CFLAGS += -DMML_VERSION=MML_VERSION_MM

PYTHON ?= .venv/bin/python3

all: $(TARGET)

objs: $(OBJS)

# Image base 0x40000000: code, data and the brk heap then sit above
# 0x10000000, so a real pointer never looks like an N64 segmented address
$(TARGET): $(OBJS) $(PORT_OBJS)
	$(LINK) -no-pie -Wl,--image-base=0x40000000 -Wl,--error-limit=0 $^ -o $@ $(ASSET_SYMBOLS) $(LIBS)

# Platform layer: system headers (EGL, DRM, ALSA) need a real Linux target,
# so build it with the clang wrapper
$(BUILD_DIR)/src/s30/%.o: src/s30/%.c
	@mkdir -p $(dir $@)
	$(LINK) $(filter-out -fno-toplevel-reorder -mfloat-abi=hard -fno-short-enums -isystem $(SYSROOT)/usr/include,$(CFLAGS)) \
	    -I$(SYSROOT)/usr/include/libdrm -c $< -o $@

# The decomp's extraction and the sources it generates, from
# baseroms/$(VERSION)/baserom.z64. No MIPS toolchain is used: the decomp's
# Makefile only checks that its binutils exist, so any ld passes.
UPSTREAM = $(MAKE) -f Makefile VERSION=$(VERSION) MIPS_BINUTILS_PREFIX=arm-none-eabi- PYTHON=$(PYTHON)
extract:
	$(UPSTREAM) setup
	$(UPSTREAM) assets
	$(UPSTREAM) asset_files schedule_inc_files \
	    build/$(VERSION)/assets/text/message_data.enc.h build/$(VERSION)/assets/text/message_data_staff.enc.h \
	    build/$(VERSION)/dmadata/dmadata_table_spec.h \
	    build/$(VERSION)/assets/audio/samplebank_table.h build/$(VERSION)/assets/audio/soundfont_table.h
	$(UPSTREAM) $$(ls build/$(VERSION)/assets/audio/soundfonts/*.xml | sed 's/\.xml$$/.h/')
	$(PYTHON) pc_tools/audio_sizes.py --version $(VERSION)

assets:
	S30_SYSROOT=$(SYSROOT) MM_VERSION=$(VERSION) $(PYTHON) pc_tools/make_assets.py

$(BUILD_DIR)/src/%.o: src/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@ 2> $@.err || { echo "FAIL $<"; false; }
	@rm -f $@.err

# Actor overlays are linked in, so their statics would outlive the overlay: each
# one's .data and .bss get their own sections (ovl_data_<name>, ovl_bss_<name>),
# which the game resets whenever the overlay loads again, as Overlay_Load would
$(BUILD_DIR)/src/overlays/actors/%.o: src/overlays/actors/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@ 2> $@.err || { echo "FAIL $<"; false; }
	@rm -f $@.err
	@$(OBJCOPY) --rename-section .data=ovl_data_$(OVL_NAME) --rename-section .bss=ovl_bss_$(OVL_NAME) $@

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

clean-assets:
	rm -rf build_assets/assets data

.PHONY: all objs extract assets clean clean-assets

-include $(OBJS:.o=.d) $(PORT_OBJS:.o=.d)
